{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "tomtom",
  "version": "1.0.0-ghast.1",
  "description": "Find places, geocode addresses, compare routes and inspect traffic with TomTom Maps.",
  "author": {
    "name": "Ghast AI",
    "url": "https://ghast.trapezohe.ai"
  },
  "homepage": "https://docs.tomtom.com/tomtom-maps-mcp/documentation/quick-setup",
  "license": "MIT",
  "extensions": {
    "ai.trapezohe.ghast": {
      "category": "lifestyle",
      "icon": "./assets/icon.svg",
      "displayName": "TomTom",
      "descriptions": {
        "en": "Find places, geocode addresses, compare routes and inspect traffic with TomTom Maps.",
        "zh-CN": "通过 TomTom 地图查找地点、解析地址、比较路线和查看交通，辅助出行与物流规划。"
      },
      "mcpServerExtensions": {
        "tomtom": {
          "credentialHeaders": {
            "tomtom-api-key": "$VAULT:tomtom-api-key"
          }
        }
      }
    }
  }
}
