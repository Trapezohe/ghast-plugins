{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "grafana",
  "version": "1.0.0-ghast.1",
  "description": "Explore dashboards, metrics, logs, alerts and incidents using Grafana’s official MCP server.",
  "author": {
    "name": "Ghast AI",
    "url": "https://ghast.trapezohe.ai"
  },
  "homepage": "https://grafana.com/docs/grafana/latest/developer-resources/mcp/set-up/",
  "license": "MIT",
  "extensions": {
    "ai.trapezohe.ghast": {
      "officialConnectorSource": "https://grafana.com/docs/grafana/latest/developer-resources/mcp/set-up/",
      "connectorPublisher": "Grafana",
      "category": "developer-tools",
      "icon": "./assets/icon.png",
      "displayName": "Grafana",
      "descriptions": {
        "en": "Explore dashboards, metrics, logs, alerts and incidents using Grafana’s official MCP server.",
        "zh-CN": "通过 Grafana 官方 MCP 探索仪表盘、指标、日志、告警与事件。"
      },
      "mcpServerExtensions": {
        "grafana": {
          "credentialEnv": {
            "GRAFANA_URL": "$VAULT:grafana-url",
            "GRAFANA_SERVICE_ACCOUNT_TOKEN": "$VAULT:grafana-token"
          }
        }
      }
    }
  }
}
