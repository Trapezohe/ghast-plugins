{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "circleci-hosted": {
      "type": "streamable-http",
      "url": "https://mcp.circleci.com/v1/mcp"
    },
    "circleci-cli": {
      "type": "stdio",
      "command": "circleci",
      "args": [
        "mcp",
        "start"
      ]
    }
  }
}
