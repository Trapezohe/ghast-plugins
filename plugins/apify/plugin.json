{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "apify",
  "description": "Discover web data Actors and run scoped extraction workflows.",
  "author": {
    "name": "Ghast AI",
    "url": "https://ghast.trapezohe.ai"
  },
  "homepage": "https://docs.apify.com/integrations/mcp",
  "license": "MIT",
  "extensions": {
    "ai.trapezohe.ghast": {
      "category": "web",
      "icon": "./assets/icon.svg",
      "displayName": "Apify",
      "descriptions": {
        "en": "Discover web data Actors and run scoped extraction workflows.",
        "zh-CN": "检索网页数据采集 Actor，执行限定范围的数据提取。"
      },
      "mcpServerExtensions": {
        "apify": {
          "credentialHeaders": {
            "Authorization": "Bearer $VAULT:apify-token"
          },
          "optionalCredentials": [
            "apify-token"
          ],
          "oauthRequired": true
        }
      }
    }
  }
}
