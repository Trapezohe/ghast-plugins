{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "bitget",
  "description": "Explore crypto market data and manage Bitget account, order and position workflows.",
  "author": {
    "name": "Ghast AI",
    "url": "https://ghast.trapezohe.ai"
  },
  "homepage": "https://github.com/Bitget-AI/agent-mcp",
  "license": "MIT",
  "extensions": {
    "ai.trapezohe.ghast": {
      "officialConnectorSource": "https://github.com/Bitget-AI/agent-mcp",
      "connectorPublisher": "Bitget",
      "category": "finance",
      "icon": "./assets/icon.png",
      "displayName": "Bitget",
      "descriptions": {
        "en": "Explore crypto market data and manage Bitget account, order and position workflows.",
        "zh-CN": "查询加密货币行情，处理 Bitget 账户、订单与持仓工作流。"
      },
      "mcpServerExtensions": {
        "bitget": {
          "credentialEnv": {
            "BITGET_API_KEY": "$VAULT:bitget-api-key",
            "BITGET_SECRET_KEY": "$VAULT:bitget-secret-key",
            "BITGET_PASSPHRASE": "$VAULT:bitget-passphrase"
          }
        }
      }
    }
  }
}
