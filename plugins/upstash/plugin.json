{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "upstash",
  "version": "1.0.0-ghast.1",
  "description": "Query and manage Upstash Redis data, run Redis commands and search official documentation.",
  "author": {
    "name": "Ghast AI",
    "url": "https://ghast.trapezohe.ai"
  },
  "homepage": "https://github.com/upstash/redis-mcp",
  "license": "MIT",
  "extensions": {
    "ai.trapezohe.ghast": {
      "officialConnectorSource": "https://github.com/upstash/redis-mcp",
      "connectorPublisher": "Upstash Redis",
      "category": "databases",
      "icon": "./assets/icon.png",
      "displayName": "Upstash Redis",
      "descriptions": {
        "en": "Query and manage Upstash Redis data, run Redis commands and search official documentation.",
        "zh-CN": "查询与管理 Upstash Redis 数据、执行 Redis 命令并搜索官方文档。"
      },
      "mcpServerExtensions": {
        "upstash": {
          "credentialEnv": {
            "UPSTASH_REDIS_REST_URL": "$VAULT:upstash-rest-url",
            "UPSTASH_REDIS_REST_TOKEN": "$VAULT:upstash-rest-token"
          }
        }
      }
    }
  }
}
