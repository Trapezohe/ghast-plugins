{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "kontent-ai",
  "version": "1.0.0-ghast.1",
  "description": "Use Kontent.ai’s official MCP to manage structured content, models, assets, language variants and publishing workflows.",
  "author": {
    "name": "Ghast AI",
    "url": "https://ghast.trapezohe.ai"
  },
  "homepage": "https://kontent.ai/learn/docs/ai/mcp-server",
  "license": "MIT",
  "extensions": {
    "ai.trapezohe.ghast": {
      "officialConnectorSource": "https://kontent.ai/learn/docs/ai/mcp-server",
      "connectorPublisher": "Kontent.ai",
      "category": "marketing",
      "icon": "./assets/icon.png",
      "displayName": "Kontent.ai",
      "descriptions": {
        "en": "Use Kontent.ai’s official MCP to manage structured content, models, assets, language variants and publishing workflows.",
        "zh-CN": "通过 Kontent.ai 官方 MCP 管理结构化内容、内容模型、素材、多语言版本和发布工作流。"
      },
      "mcpServerExtensions": {
        "kontent-ai": {
          "credentialEnv": {
            "KONTENT_API_KEY": "$VAULT:kontent-ai-api-key",
            "KONTENT_ENVIRONMENT_ID": "$VAULT:kontent-ai-environment-id"
          }
        }
      }
    }
  }
}
