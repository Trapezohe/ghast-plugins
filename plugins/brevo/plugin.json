      "connectorPublisher": "Brevo",
      "category": "marketing",
      "icon": "./assets/icon.svg",
      "displayName": "Brevo",
      "descriptions": {
        "en": "Manage contacts, email campaigns, templates, CRM records and marketing analytics in Brevo.",
