{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "brevo",
  "description": "Manage contacts, email campaigns, templates, CRM records and marketing analytics in Brevo.",
  "author": {
    "name": "Ghast AI",
    "url": "https://ghast.trapezohe.ai"
  },
  "homepage": "https://help.brevo.com/hc/en-us/articles/27978590646802-What-is-Model-Context-Protocol-MCP",
  "license": "MIT",
  "extensions": {
    "ai.trapezohe.ghast": {
