{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "configcat",
  "description": "Manage feature flags, targeting rules, products and environments through ConfigCat’s official MCP server.",
  "author": {
    "name": "Ghast AI",
    "url": "https://ghast.trapezohe.ai"
  },
  "homepage": "https://configcat.com/docs/advanced/mcp-server/",
  "license": "MIT",
  "extensions": {
    "ai.trapezohe.ghast": {
      "officialConnectorSource": "https://configcat.com/docs/advanced/mcp-server/",
      "connectorPublisher": "ConfigCat",
      "category": "development",
      "icon": "./assets/icon.png",
      "displayName": "ConfigCat",
      "descriptions": {
        "en": "Manage feature flags, targeting rules, products and environments through ConfigCat’s official MCP server.",
        "zh-CN": "通过 ConfigCat 官方 MCP 服务管理功能开关、定向规则、产品与环境。"
      },
      "mcpServerExtensions": {
        "configcat": {
          "credentialEnv": {
            "CONFIGCAT_API_USER": "$VAULT:configcat-api-user",
            "CONFIGCAT_API_PASS": "$VAULT:configcat-api-password"
          }
        }
      }
    }
  }
}
