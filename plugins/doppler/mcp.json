{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "doppler": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@dopplerhq/mcp-server@1.0.5"
      ],
      "cwd": "${PLUGIN_DATA}",
      "env": {
        "DOPPLER_BASE_URL": "https://api.doppler.com"
      }
    }
  }
}
