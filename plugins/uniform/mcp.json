{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "uniform": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@uniformdev/uniform-mcp@20.63.0"
      ],
      "cwd": "${PLUGIN_DATA}",
      "env": {
        "UNIFORM_API_HOST": "https://uniform.app",
        "UNIFORM_AI_API_HOST": "https://ai.uniform.global"
      }
    }
  }
}
