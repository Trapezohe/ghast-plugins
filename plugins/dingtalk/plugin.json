{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "dingtalk",
  "version": "1.0.0-ghast.2",
  "description": "Access contacts, calendars, tasks, reports and collaboration services through DingTalk’s official MCP.",
  "author": {
    "name": "Ghast AI",
    "url": "https://ghast.trapezohe.ai"
  },
  "homepage": "https://github.com/open-dingtalk/dingtalk-mcp",
  "license": "MIT",
  "extensions": {
    "ai.trapezohe.ghast": {
      "officialConnectorSource": "https://github.com/open-dingtalk/dingtalk-mcp",
      "connectorPublisher": "DingTalk",
      "category": "productivity",
      "icon": "./assets/icon.png",
      "displayName": "DingTalk",
      "descriptions": {
        "en": "Access contacts, calendars, tasks, reports and collaboration services through DingTalk’s official MCP.",
        "zh-CN": "通过钉钉官方 MCP 访问通讯录、日历、待办、日志与协作服务。"
      },
      "mcpServerExtensions": {
        "dingtalk": {
          "credentialEnv": {
            "DINGTALK_Client_ID": "$VAULT:dingtalk-client-id",
            "DINGTALK_Client_Secret": "$VAULT:dingtalk-client-secret",
            "ROBOT_CODE": "$VAULT:dingtalk-robot-code",
            "ROBOT_ACCESS_TOKEN": "$VAULT:dingtalk-robot-token",
            "DINGTALK_AGENT_ID": "$VAULT:dingtalk-agent-id"
          },
          "optionalCredentials": [
            "dingtalk-robot-code",
            "dingtalk-robot-token",
            "dingtalk-agent-id"
          ]
        }
      }
    }
  }
}
